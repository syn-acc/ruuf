[Unit]
Description=@NAME@ soft machine: continuous lab runner for @CHANNEL@
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=simple
User=hermes
Group=hermes
Environment=HERMES_HOME=/data/syn.gl/hermes/.hermes
Environment=HOME=/data/syn.gl/hermes
Environment=CODEX_HOME=/data/syn.gl/hermes/.codex
Environment=PATH=/data/syn.gl/hermes/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=@MACHINE@
ExecStart=/data/syn.gl/hermes/runtime/venv/bin/python @MACHINE@/soft_machine.py --seed @SEED@ --config /data/syn.gl/hermes/.hermes/@ID@-lab.json --daemon
Restart=on-failure
RestartSec=15
SyslogIdentifier=@ID@-soft-machine
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data/syn.gl/hermes/.hermes/@ID@-lab /data/syn.gl/hermes/.codex
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=768M
TasksMax=128

[Install]
WantedBy=multi-user.target

[Unit]
Description=@NAME@ frontier scan: daily digest of papers, open models and tool releases
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hermes
Group=hermes
Environment=HERMES_HOME=/data/syn.gl/hermes/.hermes
Environment=PYTHONUNBUFFERED=1
ExecStart=/data/syn.gl/hermes/runtime/venv/bin/python @MACHINE@/frontier_scan.py --seed @SEED@
SyslogIdentifier=@ID@-frontier-scan
TimeoutStartSec=240
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data/syn.gl/hermes/.hermes/@ID@-lab
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=256M
TasksMax=16

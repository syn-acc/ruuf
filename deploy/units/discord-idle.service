[Unit]
Description=SCRU contextual idle question (three-hour silence gate)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hermes
Group=hermes
Environment=HERMES_HOME=/data/syn.gl/hermes/.hermes
Environment=HOME=/data/syn.gl/hermes
Environment=CODEX_HOME=/data/syn.gl/hermes/.codex
Environment=PATH=/data/syn.gl/hermes/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/data/syn.gl/hermes/plugins/discord-idle
ExecStart=/data/syn.gl/hermes/runtime/venv/bin/python /data/syn.gl/hermes/plugins/discord-idle/run.py --config /data/syn.gl/hermes/.hermes/discord-idle.json --send
TimeoutStartSec=240
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data/syn.gl/hermes/.hermes/discord-idle /data/syn.gl/hermes/.codex
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6


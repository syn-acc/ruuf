[Unit]
Description=syn.gl Hermes Discord agent (Codex CLI runtime)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/data/syn.gl/hermes/workspace

Environment=HOME=/data/syn.gl/hermes
Environment=HERMES_HOME=/data/syn.gl/hermes/.hermes
Environment=CODEX_HOME=/data/syn.gl/hermes/.codex
Environment=PATH=/data/syn.gl/hermes/.local/bin:/data/syn.gl/hermes/.hermes/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

ExecStart=/data/syn.gl/hermes/.local/bin/hermes gateway

Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=mixed

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bot-syn-gl

UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
# Codex's nested bubblewrap workspace sandbox configures loopback through
# NETLINK_ROUTE. Without AF_NETLINK, scheduled turns cannot initialize the
# inner sandbox and fall back to an interactive approval that cron cannot grant.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/data/syn.gl/hermes
InaccessiblePaths=/data/hfct/secrets

LimitNOFILE=65535
TasksMax=512
MemoryMax=4G

[Install]
WantedBy=multi-user.target

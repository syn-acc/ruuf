[Unit]
Description=Ruu legs: one request (status, stride or result)
CollectMode=inactive-or-failed

[Service]
ExecStart=/usr/bin/python3 -I /opt/ruu-legs/runner.py
StandardInput=socket
StandardOutput=socket
StandardError=journal
SyslogIdentifier=ruu-legs
# Root, because a stride is started as another user through systemd-run. The runner takes
# parameters only, builds the command as a list, and never executes anything the caller wrote.
User=root
UMask=0077
RuntimeMaxSec=60
TimeoutStopSec=5
MemoryMax=256M
TasksMax=32
Nice=10
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX

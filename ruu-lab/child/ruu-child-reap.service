[Unit]
Description=Child system: stop any Colab session that outlived its deadline

[Service]
Type=oneshot
User=ruu-child
Group=ruu-child
Environment=HOME=/data/ruu-child
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/data/ruu-child
ExecStart=/data/ruu-child/venv/bin/python -W ignore /opt/ruu-child/launch.py reap
SyslogIdentifier=ruu-child-reap
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/data/ruu-child
CapabilityBoundingSet=

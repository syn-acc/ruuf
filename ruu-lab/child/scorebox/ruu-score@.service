[Unit]
Description=Child system scoring box: one sandboxed run of untrusted code
CollectMode=inactive-or-failed

[Service]
ExecStart=/usr/bin/python3 -I /opt/ruu-score/runner.py
StandardInput=socket
StandardOutput=socket
StandardError=journal
SyslogIdentifier=ruu-score
User=ruu-score
Group=ruu-score
UMask=0077

# Time, memory, processes, disk writes.
RuntimeMaxSec=90
TimeoutStopSec=5
KillMode=control-group
MemoryMax=1G
MemorySwapMax=0
OOMPolicy=continue
CPUQuota=100%
TasksMax=48
LimitNOFILE=256
LimitFSIZE=32M
Nice=12

# No network at all: its own empty network namespace, and no socket families.
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX

# It sees an operating system and a private /tmp that dies with the job. Nothing else on the
# server, and nothing left behind by an earlier job. Same shape as ruu-hands@.service, which was
# attack-tested on this host; /run is made inaccessible for the reason noted there.
ProtectSystem=strict
ProtectHome=yes
TemporaryFileSystem=/data:ro /srv:ro /opt:ro /var:ro /root:ro /mnt:ro /media:ro /boot:ro /etc:ro
InaccessiblePaths=/run
BindReadOnlyPaths=/opt/ruu-score /etc/ld.so.cache /etc/localtime
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
PrivateUsers=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

# No privileges and no way to gain any.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~socket socketpair connect bind listen
SystemCallErrorNumber=EPERM

[Unit]
Description=Ruu frontier scan: daily digest of papers, open models and tool releases
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hermes
Group=hermes
Environment=HERMES_HOME=/data/syn.gl/hermes/.hermes
Environment=PYTHONUNBUFFERED=1
ExecStart=/data/syn.gl/hermes/runtime/venv/bin/python /data/syn.gl/hermes/plugins/ruu-lab/frontier_scan.py
SyslogIdentifier=ruu-frontier-scan
TimeoutStartSec=240
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data/syn.gl/hermes/.hermes/ruu-lab
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=256M
TasksMax=16

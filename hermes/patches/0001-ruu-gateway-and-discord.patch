+class CodexCompletedMessageAgent:
+    """Mimic app-server's final agentMessage delta + completed events."""
+
+    def __init__(self, **kwargs):
+        self.interim_assistant_callback = kwargs.get("interim_assistant_callback")
+        self.stream_delta_callback = kwargs.get("stream_delta_callback")
+        self.tools = []
+
+    def run_conversation(self, message, conversation_history=None, task_id=None):
+        final = "Hey Syn! What can I help you with?"
+        if self.stream_delta_callback:
+            self.stream_delta_callback(final)
+        if self.interim_assistant_callback:
+            self.interim_assistant_callback(final, already_streamed=True)
+        return {
+            "final_response": final,
+            # App-server completed agentMessage events intentionally do not
+            # set this generic final-preview flag.
+            "response_previewed": False,
+            "messages": [],
+            "api_calls": 1,
+        }

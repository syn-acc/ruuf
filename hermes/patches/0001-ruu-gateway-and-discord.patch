+def _discord_speaking_pair(message: Any) -> Optional[Tuple[int, int]]:
+    """Return ``(audio_ssrc, user_id)`` for a Discord voice identity frame.
+
+    Discord can announce the mapping through SPEAKING (op 5) or a VIDEO frame
+    (op 12, which also carries ``audio_ssrc``). The latter may arrive before a
+    fresh speaking transition.
+    """
+    if not isinstance(message, dict) or message.get("op") not in {5, 12}:
+        return None
+    data = message.get("d") or {}
+    ssrc = data.get("ssrc") if message.get("op") == 5 else data.get("audio_ssrc")
+    user_id = data.get("user_id")
+    if not ssrc or not user_id:
+        return None
+    try:
+        return int(ssrc), int(user_id)
+    except (TypeError, ValueError):
+        return None
+
+
+if DISCORD_AVAILABLE:
+    class _HermesReceiveVoiceClient(discord.VoiceClient):
+        """VoiceClient that captures SSRC mappings during the handshake.
+
+        Discord normally sends the initial SPEAKING frames before
+        ``channel.connect()`` returns. Installing a hook only after connect
+        therefore misses every already-present speaker; DAVE audio cannot be
+        decrypted without the SSRC-to-user mapping. This client installs the
+        hook when the connection state is created, before the websocket opens.
+        """
+
+        def create_connection_state(self):
+            from discord.voice_state import VoiceConnectionState
+
+            self._hermes_ssrc_to_user: Dict[int, int] = {}
+
+            async def _capture_speaking(_ws, message):
+                pair = _discord_speaking_pair(message)
+                if pair is None:
+                    return
+                ssrc, user_id = pair
+                self._hermes_ssrc_to_user[ssrc] = user_id
+                logger.info(
+                    "Early voice SSRC event: ssrc=%d -> user=%d",
+                    ssrc,
+                    user_id,
+                )
+
+            return VoiceConnectionState(self, hook=_capture_speaking)
+else:
+    _HermesReceiveVoiceClient = None
+
